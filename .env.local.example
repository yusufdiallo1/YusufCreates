# ---------------------------------------------------------------------------
# YusufCreates — environment variables
#
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------

# --- App ------------------------------------------------------------------

# Public base URL of this app. Used for absolute links, emails and OAuth
# redirects. No trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Convex ---------------------------------------------------------------

# Public URL of your Convex deployment, e.g. https://acme-cat-123.convex.cloud
# Written automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Deploy key for CI / production builds (`npx convex deploy`). Generate it in
# the Convex dashboard under Settings → Deploy Keys. Server-side only.
CONVEX_DEPLOY_KEY=


# --- Auth (@convex-dev/auth) ----------------------------------------------

# Private key used to sign auth JWTs. Generate with:
#   npx @convex-dev/auth
# which sets this in your Convex deployment. Keep it out of the client.
JWT_PRIVATE_KEY=

# Canonical site URL used by Convex Auth for callbacks and redirects.
# Must match NEXT_PUBLIC_APP_URL in each environment.
SITE_URL=http://localhost:3000

# GitHub OAuth app credentials. Set these in the Convex dashboard, not just
# locally — Convex functions read them at runtime.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The ONLY GitHub account permitted to sign in. Use the numeric GitHub user id
# (https://api.github.com/users/<handle> -> "id"), not the login handle, since
# handles can be changed and reused by someone else.
# Sign-in fails closed if this is unset.
ADMIN_GITHUB_ID=

# The ONLY email address permitted to sign in with the Password provider.
# Read by Convex functions, so it must be set on the DEPLOYMENT, not just here:
#   npx convex env set ADMIN_EMAIL you@example.com
# Sign-in fails closed if unset — the account is created then deleted.
ADMIN_EMAIL=


# --- Email (Resend + React Email) -----------------------------------------

# Resend API key (starts with re_). Create at https://resend.com/api-keys
RESEND_API_KEY=

# Default From address for transactional email. The domain must be verified
# in Resend, e.g. "YusufCreates <hello@yusufcreates.com>"
EMAIL_FROM=

# Signing secret for Resend webhooks (delivery, bounce, complaint events).
# Only needed if you consume Resend webhooks.
RESEND_WEBHOOK_SECRET=

# Where enquiry notifications are sent. Needed by BOTH the Next app (this file)
# and Convex functions (`npx convex env set ADMIN_EMAIL ...`), since Convex
# does not read .env.local.
# Without it the confirmation to the client still sends; only the notification
# to you is skipped.
ADMIN_EMAIL=


# --- Stripe ---------------------------------------------------------------

# Secret API key (sk_test_... in test mode). Server-side only — never expose.
STRIPE_SECRET_KEY=

# Publishable key (pk_test_...). Safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...) used to verify Stripe webhook payloads.
# From `stripe listen` locally, or the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_...) backing the tiers in src/lib/pricing.ts.
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=


# --- Anthropic ------------------------------------------------------------

# API key for the Claude API (starts with sk-ant-). Server-side only.
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Apple Pay ------------------------------------------------------------
# Domain verification file goes at:
#   public/.well-known/apple-developer-merchantid-domain-association
# Download it from Stripe > Settings > Payment methods > Apple Pay, add the
# domain there, then verify. If this is wrong Apple Pay simply does not appear
# — there is no error message. Test on a real iPhone in Safari, not a simulator.

# --- Chat assistant ---------------------------------------------------------

# Anthropic key for the site assistant. Without it the chat route fails closed
# with a 503 rather than erroring.
ANTHROPIC_API_KEY=

# --- Site audit -------------------------------------------------------------

# PageSpeed Insights key. Free, but needs a Google Cloud project with the API
# enabled — without one you get roughly one request per second, which the rate
# limiter cannot rely on.
PAGESPEED_API_KEY=

# --- Call booking -----------------------------------------------------------

# Your Cal.com path, e.g. "yusuf/intro". Public by design.

# --- Server-to-server -------------------------------------------------------

# Shared secret gating the mutations that server routes call on your behalf:
# email logging, Stripe webhook writes, chat rate limits and audit results.
# Must be set on BOTH the Next runtime and the Convex deployment:
#   npx convex env set EMAIL_LOG_SECRET <value>
# Everything gated by it fails closed when unset.
EMAIL_LOG_SECRET=

# --- Credential vault -------------------------------------------------------

# AES-256-GCM key for the client credential store. CONVEX ONLY — the
# encryption happens in a Convex action and this must never reach the Next
# runtime or the browser:
#   npx convex env set CREDENTIAL_ENCRYPTION_KEY "$(openssl rand -base64 32)"
#
# 32 bytes, base64 (hex is also accepted). There is deliberately no fallback:
# an unset key throws rather than degrading to plaintext, because a silent
# downgrade is a permanent breach that looks like it is working.
#
# Changing it orphans every existing credential — they are stamped with a
# keyVersion and will refuse to decrypt against a different key.

# --- Notifications ----------------------------------------------------------

# Convex writes notifications to an outbox and pokes Next.js to send them.
# For that to work, the CONVEX deployment needs to know where to post and how
# to authenticate:
#   npx convex env set SITE_URL https://www.yusufcreates.com
#   npx convex env set EMAIL_LOG_SECRET <the same value as below>
#
# ⚠ SITE_URL must be the CANONICAL origin — the one the site does NOT redirect
# away from. Get it wrong (apex when the site serves www, or the reverse) and
# fetch drops the Authorization header on the cross-origin hop, so the
# dispatcher answers 401 to a request carrying the correct secret. The action
# refuses to follow redirects precisely so this logs as "SITE_URL redirects"
# instead of as a baffling auth failure.
#
# ⚠ Convex environments are PER DEPLOYMENT. `npx convex env set` writes to dev;
# production needs `--prod` as well. Dev being stale while prod is correct is
# the normal way this ends up half-configured.
#
# Nothing breaks when these are wrong — notifications queue until the daily
# Vercel cron drains them. What is lost is immediacy: an outage alert becomes
# a next-morning one. The Convex log says so on every attempt.

# --- Monitoring -------------------------------------------------------------

# The uptime, SSL and Lighthouse sweeps run on the CONVEX scheduler, not on a
# Vercel cron — the Hobby plan rejects anything more frequent than once a day
# at deploy time, which makes a five-minute check impossible there.
#
# The weekly Lighthouse run needs the PageSpeed key on the Convex side too:
#   npx convex env set PAGESPEED_API_KEY <value>

# --- Web push ---------------------------------------------------------------

# Outage alerts to my own devices. Generate a pair with:
#   npx web-push generate-vapid-keys
#
# The public key is needed in both places — the browser uses it to subscribe.
# Push is admin-only and never offered to clients. Unset, the toggle in the
# admin top bar renders nothing at all rather than pretending to be armed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# mailto: or https: — the push service rejects anything else, at send time,
# with an opaque 400. Defaults to hello@yusufcreates.com if unset.
VAPID_SUBJECT=
